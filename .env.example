# Browser-visible FastAPI address used by the web app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated browser origins accepted by FastAPI.
MATH_AI_CORS_ORIGINS=http://localhost:3000

# Override only when the curriculum CSV is moved.
MATH_AI_CURRICULUM_CSV=docs/high-school-math-ai/curriculum/pep-a-required-1-knowledge-tree-v1.csv
